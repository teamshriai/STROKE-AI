# Stroke-AI backend (FastAPI + PyTorch) as a systemd service.
#
# Install:
#   sudo cp /var/www/stroke-ai.org/deploy/stroke-ai-api.service \
#           /etc/systemd/system/stroke-ai-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stroke-ai-api
#
# Logs:  sudo journalctl -u stroke-ai-api -f

[Unit]
Description=Stroke-AI API (FastAPI + PyTorch NCCT haemorrhage model)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anand
Group=anand
WorkingDirectory=/var/www/stroke-ai.org/server

# Bound to localhost only — nginx is the only thing that should reach it, so
# port 8000 stays closed in the AWS security group.
ExecStart=/var/www/stroke-ai.org/server/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 8000 --workers 1

# Each worker loads its own copy of the model (~800 MB resident with torch),
# so raise --workers only if the instance has the RAM to spare.
#
# Cap torch's thread pool to the instance's vCPU count; left unset it spawns a
# thread per core and thrashes on a small instance.
Environment="OMP_NUM_THREADS=2"
Environment="MKL_NUM_THREADS=2"

# Not needed while nginx serves the frontend and API from one hostname.
# Set only if the frontend is ever served from a different origin:
# Environment="STROKE_AI_ALLOWED_ORIGINS=https://stroke-ai.org"

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
