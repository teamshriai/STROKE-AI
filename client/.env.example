# Base URL of the Stroke-AI backend (server/).
#
# Leave this file uncopied for the normal cases:
#   - `npm run dev`   -> defaults to http://localhost:8000
#   - `npm run build` -> defaults to same-origin (relative /api paths), which is
#                        what the nginx deployment in DEPLOYMENT.md serves
#
# Only set this when the API is on a different host or port than the frontend:
# VITE_API_BASE_URL=https://api.example.com
